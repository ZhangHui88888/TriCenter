# Copy to /etc/tricenter/tricenter.env, insert unique secrets, then chmod 600.
DB_URL=jdbc:mysql://127.0.0.1:3306/tricenter?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USER=replace_me
DB_PASSWORD=replace_me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_me
REDIS_DATABASE=1
JWT_SECRET=replace_with_at_least_32_random_bytes
TRICENTER_API_KEY=replace_with_a_unique_random_value
TRICENTER_UPLOAD_DIR=/var/lib/tricenter/uploads
TRICENTER_QUARANTINE_DIR=/var/lib/tricenter/quarantine
MANAGEMENT_PORT=8082
